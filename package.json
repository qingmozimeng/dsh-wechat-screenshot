{
  "name": "dsh-wechat-screenshot",
  "version": "1.3.1",
  "description": "跟微信原生截图差不多的 Windows 独立截图插件，由 DeepSeek 与 ChatGPT 联合开发。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "wechat",
    "windows",
    "annotation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./electron": "./native-gpu/host.cjs",
    "./preload": "./native-gpu/main-preload.cjs"
  },
  "files": [
    "index.js",
    "client.js",
    "overlay.ps1",
    "native.ps1",
    "capture.ps1",
    "copy-image.ps1",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "native-gpu/build.cjs",
    "native-gpu/host.cjs",
    "native-gpu/main-preload.cjs",
    "native-gpu/origin.cjs",
    "native-gpu/overlay-preload.cjs",
    "native-gpu/overlay.html",
    "native-gpu/package-lock.json",
    "native-gpu/package.json",
    "native-gpu/React-LICENSE",
    "native-gpu/ReactDOM-LICENSE",
    "native-gpu/renderer-entry.jsx",
    "native-gpu/renderer.js",
    "native-gpu/Scheduler-LICENSE",
    "native-gpu/windows.ps1",
    "native-gpu/worker.cjs",
    "ELECTRON.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "清墨子梦",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingmozimeng/dsh-wechat-screenshot.git"
  },
  "homepage": "https://github.com/qingmozimeng/dsh-wechat-screenshot#readme",
  "bugs": {
    "url": "https://github.com/qingmozimeng/dsh-wechat-screenshot/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check native-gpu/host.cjs && node --check native-gpu/renderer.js",
    "test": "node --test test/*.test.cjs"
  }
}
